---
import Icon from './Icon.astro';

interface TimelineEvent {
  date: string;
  title: string;
  description: string;
  type: 'personal' | 'education' | 'work' | 'certification';
  highlight?: boolean;
  details?: string;
}

interface Props {
  events: TimelineEvent[];
  showAll?: boolean;
}

const { events, showAll = true } = Astro.props;

const displayEvents = showAll ? events : events.filter(e => e.highlight);

const typeIcons: Record<string, string> = {
  personal: 'heart',
  education: 'code',
  work: 'strategy',
  certification: 'trophy',
};

function formatDate(date: string): string {
  if (date === 'present') return 'Present';
  if (date.length === 4) return date;
  const [year, month] = date.split('-');
  const monthNames = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
  return `${monthNames[parseInt(month) - 1]} ${year}`;
}
---

<div class="timeline">
  {displayEvents.map((event, index) => (
    <div class:list={['timeline-item', 'reveal-on-scroll', event.type, { highlight: event.highlight }]}>
      <div class="marker-col">
        <div class={`marker ${event.type}`}>
          <Icon icon={typeIcons[event.type]} size="1em" />
        </div>
        {index < displayEvents.length - 1 && <div class="connector"></div>}
      </div>
      <div class="content-col">
        <div class="card">
          <span class="date">{formatDate(event.date)}</span>
          <h3 class="title">{event.title}</h3>
          <p class="description">{event.description}</p>
        </div>
      </div>
    </div>
  ))}
</div>

<style>
  .timeline {
    max-width: 700px;
    margin: 0 auto;
  }

  .timeline-item {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 1rem;
  }

  .marker-col {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .marker {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--gray-999);
    flex-shrink: 0;
    background: var(--accent-regular);
  }

  .marker.personal { background: #ec4899; } /* pink-500 - visible in both modes */
  .marker.education { background: #3b82f6; } /* blue-500 - bright blue */
  .marker.work { background: #14b8a6; } /* teal-500 - bright teal */
  .marker.certification { background: #f59e0b; } /* amber-500 */

  .connector {
    width: 2px;
    flex: 1;
    min-height: 1rem;
    background: var(--gray-700);
  }

  .content-col {
    padding-bottom: 1.5rem;
  }

  .card {
    background: var(--gray-999);
    border: 1px solid var(--gray-800);
    border-radius: 0.75rem;
    padding: 1rem 1.25rem;
  }

  .timeline-item.highlight .card {
    border-color: var(--accent-regular);
    background: var(--gradient-subtle);
  }

  .date {
    display: inline-block;
    font-size: var(--text-sm);
    color: var(--accent-regular);
    font-weight: 600;
    margin-bottom: 0.25rem;
  }

  .title {
    font-size: var(--text-md);
    color: var(--gray-0);
    margin: 0 0 0.5rem;
    line-height: 1.3;
  }

  .description {
    font-size: var(--text-sm);
    color: var(--gray-300);
    margin: 0;
    line-height: 1.5;
  }

  /* Desktop enhancements */
  @media (min-width: 50em) {
    .timeline {
      max-width: 800px;
    }

    .timeline-item {
      grid-template-columns: 4rem 1fr;
      gap: 1.5rem;
    }

    .marker {
      width: 3rem;
      height: 3rem;
    }

    .card {
      padding: 1.25rem 1.5rem;
      border-radius: 1rem;
    }

    .title {
      font-size: var(--text-lg);
    }

    .content-col {
      padding-bottom: 2rem;
    }
  }
</style>
